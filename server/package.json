{
  "name": "server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main/server.ts",
    "build": "tsup-node",
    "start": "node dist/main/server.js",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test-int": "vitest run --project integration",
    "test-int:watch": "vitest --project integration",
    "test-e2e": "vitest run --project e2e",
    "test-e2e:watch": "vitest --project e2e",
    "db:generate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "tsx --env-file=.env src/infrastructure/db/seeds/index.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.3",
    "@scalar/fastify-api-reference": "^1.76.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "orm": "^8.0.1",
    "postgres": "^4.0.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
